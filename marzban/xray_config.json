{
  "log": {
    "loglevel": "debug"
  },
  "api": {
    "name": ["statistics"],
    "serves": {
      "127.0.0.1:62789": "StatisticsService"
    }
  },
  "stats": {
    "outbounds": [
      { "tag": "DIRECT", "delivery": true }
    ],
    "inbounds": [
      { "tag": "VLESS Reality", "listen": "0.0.0.0", "delivery": true }
    ]
  },
  "policy": {
    "levels": {
      "0": { "handshake": 4 }
    },
    "system": {
      "statsOutboundDownlink": true,
      "statsOutboundUplink": true
    }
  },
  "dns": {
    "servers": [
      { "address": "1.1.1.1", "port": 853, "type": "tls" },
      { "address": "8.8.8.8", "port": 853, "type": "tls" },
      "77.88.8.8",
      "80.80.80.80"
    ],
    "queryStrategy": "UseIPv4",
    "cacheSize": 4096,
    "domainStrategy": "UseIPv4"
  },
  "inbounds": [
    {
      "tag": "api",
      "port": 62789,
      "protocol": "dokodemo-door",
      "listen": "127.0.0.1",
      "settings": { "address": "127.0.0.1" }
    },
    {
      "tag": "VLESS Reality",
      "listen": "0.0.0.0",
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "itunes.apple.com:443",
          "xver": 0,
          "serverNames": ["itunes.apple.com"],
          "privateKey": "OBGPuDLRkb0Cbae2t84LacjkcWY38TBw9umx1vKUHyk",
          "publicKey": "daGDXnfX27yZ0e_ADuEMLJ3s96lMs2J3DGeBBw9XT0k",
          "shortIds": ["abc123def456", "abcd"],
          "minClientVer": "1.0.0"
        },
        "sockopt": {
          "tcpFastOpen": true,
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveInterval": 15,
          "tcpKeepAliveIdle": 120
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "DIRECT",
      "settings": {
        "domainStrategy": "UseIPv4",
        "sockopt": {
          "tcpFastOpen": true,
          "tcpNoDelay": true,
          "tcpKeepAlive": true,
          "tcpKeepAliveInterval": 30
        }
      }
    },
    {
      "protocol": "blackhole",
      "tag": "BLOCK"
    }
  ],
  "routing": {
    "domainStrategy": "IPSet",
    "rules": [
      {
        "outboundTag": "DIRECT",
        "domain": [
          "full:cp.cloudflare.com",
          "domain:msftconnecttest.com",
          "domain:msftncsi.com",
          "geosite:cn"
        ],
        "type": "field"
      },
      {
        "ip": ["geoip:private"],
        "outboundTag": "BLOCK",
        "type": "field"
      },
      {
        "ip": ["geoip:cn"],
        "outboundTag": "DIRECT",
        "type": "field"
      }
    ]
  }
}
